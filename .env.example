# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Development or first-admin login (do not commit the real values)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Set to true when using Aiven's TLS connection requirements
DB_SSL=false
DB_SSL_CA=
# Set true when DB_SSL_CA points to a readable Aiven CA file
DB_SSL_VERIFY=false
